---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import cv from '../../cv/cv.json';
import * as simpleIcons from 'simple-icons';

// The PDF is compiled from cv/cv.typ by the deploy workflow (same data as this page).
const PDF = 'Federico_Ricchiuto_Resume.pdf';
const hasPdf = existsSync(`public/${PDF}`);

type Job = (typeof cv.experience)[number] & {
  points?: string[]; stack?: string;
  clients?: { name: string; period: string; text: string; stack?: string }[];
};
const experience = cv.experience as Job[];
const oneLine = (s: string) => s.replace(/\s*\n\s*/g, ' ');

// Official brand icons (Simple Icons, CC0), inlined at build time. Skills without an entry show text only
// (e.g. AWS: removed from Simple Icons at Amazon's request).
const ICON: Record<string, string> = {
  PHP: 'php', Laravel: 'laravel', Symfony: 'symfony', Java: 'openjdk', 'Spring Boot': 'springboot', 'Node.js': 'nodedotjs',
  Python: 'python', TypeScript: 'typescript', JavaScript: 'javascript', 'Vue.js': 'vuedotjs', React: 'react', Angular: 'angular',
  MySQL: 'mysql', PostgreSQL: 'postgresql', Redis: 'redis', Doctrine: 'doctrine', 'Google Cloud Platform': 'googlecloud',
  Docker: 'docker', Terraform: 'terraform', 'GitHub Actions': 'githubactions', Jenkins: 'jenkins', 'Git Flow': 'git',
  'Spring Security': 'springsecurity', 'Spring Data - Hibernate': 'hibernate', Flutter: 'flutter', Android: 'android', iOS: 'ios',
  'Claude Code': 'claudecode', MongoDB: 'mongodb',
};
// Brands missing from Simple Icons: single-path logos copied from Lobe Icons (MIT, @lobehub/icons-static-svg).
const EXTRA: Record<string, { title: string; path: string }> = {
  'OpenAI Codex': {
    title: 'OpenAI',
    path: 'M9.205 8.658v-2.26c0-.19.072-.333.238-.428l4.543-2.616c.619-.357 1.356-.523 2.117-.523 2.854 0 4.662 2.212 4.662 4.566 0 .167 0 .357-.024.547l-4.71-2.759a.797.797 0 00-.856 0l-5.97 3.473zm10.609 8.8V12.06c0-.333-.143-.57-.429-.737l-5.97-3.473 1.95-1.118a.433.433 0 01.476 0l4.543 2.617c1.309.76 2.189 2.378 2.189 3.948 0 1.808-1.07 3.473-2.76 4.163zM7.802 12.703l-1.95-1.142c-.167-.095-.239-.238-.239-.428V5.899c0-2.545 1.95-4.472 4.591-4.472 1 0 1.927.333 2.712.928L8.23 5.067c-.285.166-.428.404-.428.737v6.898zM12 15.128l-2.795-1.57v-3.33L12 8.658l2.795 1.57v3.33L12 15.128zm1.796 7.23c-1 0-1.927-.332-2.712-.927l4.686-2.712c.285-.166.428-.404.428-.737v-6.898l1.974 1.142c.167.095.238.238.238.428v5.233c0 2.545-1.974 4.472-4.614 4.472zm-5.637-5.303l-4.544-2.617c-1.308-.761-2.188-2.378-2.188-3.948A4.482 4.482 0 014.21 6.327v5.423c0 .333.143.571.428.738l5.947 3.449-1.95 1.118a.432.432 0 01-.476 0zm-.262 3.9c-2.688 0-4.662-2.021-4.662-4.519 0-.19.024-.38.047-.57l4.686 2.71c.286.167.571.167.856 0l5.97-3.448v2.26c0 .19-.07.333-.237.428l-4.543 2.616c-.619.357-1.356.523-2.117.523zm5.899 2.83a5.947 5.947 0 005.827-4.756C22.287 18.339 24 15.84 24 13.296c0-1.665-.713-3.282-1.998-4.448.119-.5.19-.999.19-1.498 0-3.401-2.759-5.947-5.946-5.947-.642 0-1.26.095-1.88.31A5.962 5.962 0 0010.205 0a5.947 5.947 0 00-5.827 4.757C1.713 5.447 0 7.945 0 10.49c0 1.666.713 3.283 1.998 4.448-.119.5-.19 1-.19 1.499 0 3.401 2.759 5.946 5.946 5.946.642 0 1.26-.095 1.88-.309a5.96 5.96 0 004.162 1.713z',
  },
  'Google Antigravity': {
    title: 'Antigravity',
    path: 'M21.751 22.607c1.34 1.005 3.35.335 1.508-1.508C17.73 15.74 18.904 1 12.037 1 5.17 1 6.342 15.74.815 21.1c-2.01 2.009.167 2.511 1.507 1.506 5.192-3.517 4.857-9.714 9.715-9.714 4.857 0 4.522 6.197 9.714 9.715z',
  },
};

const bySlug = Object.fromEntries(Object.values(simpleIcons).map((i) => [i.slug, i]));
const icon = (skill: string) => {
  if (EXTRA[skill]) return { ...EXTRA[skill], color: 'currentColor', rule: 'evenodd' };
  const i = bySlug[ICON[skill]];
  if (!i) return null;
  const [r, g, b] = [0, 2, 4].map((k) => parseInt(i.hex.slice(k, k + 2), 16));
  // near-black brand colors would vanish in dark mode: those follow the text color instead
  return { path: i.path, title: i.title, rule: 'nonzero', color: 0.2126 * r + 0.7152 * g + 0.0722 * b < 60 ? 'currentColor' : `#${i.hex}` };
};
const h2 = 'text-sm font-semibold uppercase tracking-wider text-accent';
---
<Base title="CV" description={`${cv.name} — ${cv.title.toLowerCase()} with over ten years building web applications.`}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-4xl font-bold">{cv.name}</h1>
      <p class="mt-1 font-medium text-accent">{cv.title} <span class="font-normal text-zinc-500">· {cv.location}</span></p>
      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-zinc-500">
        {cv.contacts.map((c) => <a href={c.url} class="hover:text-accent">{c.label}</a>)}
      </p>
    </div>
    {hasPdf && <a href={`/${PDF}`} download class="rounded-full bg-accent text-white px-5 py-2 text-sm hover:opacity-90">Download PDF</a>}
  </div>

  <p class="mt-8 max-w-3xl text-lg text-zinc-600 dark:text-zinc-400">
    {cv.summary} <b class="text-zinc-900 dark:text-zinc-100">{cv.highlight}</b>
  </p>

  <section class="mt-12">
    <h2 class={h2}>Experience</h2>
    <ol class="mt-4 border-l border-zinc-200 dark:border-zinc-800">
      {experience.map((e) => (
        <li class="relative pl-6 pb-10">
          <span class="absolute -left-1.5 top-2 size-3 rounded-full bg-accent"></span>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-xl font-semibold">{e.org} <span class="text-sm font-normal text-zinc-500">{e.place}</span></h3>
            <span class="text-sm text-zinc-500">{oneLine(e.period)}</span>
          </div>
          <p class="font-medium text-accent">{e.role}</p>
          <p class="mt-2 text-zinc-600 dark:text-zinc-400">{e.summary}</p>
          {e.points && <ul class="mt-2 list-disc pl-5 text-zinc-600 dark:text-zinc-400">{e.points.map((p) => <li>{p}</li>)}</ul>}
          {e.stack && <p class="mt-2 text-sm text-zinc-500"><b>Stack</b> {e.stack}</p>}
          {e.clients && (
            <div class="mt-5 space-y-5">
              {e.clients.map((c) => (
                <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 p-4">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h4 class="font-semibold">{c.name}</h4>
                    <span class="text-sm text-zinc-500">{oneLine(c.period)}</span>
                  </div>
                  <p class="mt-1 text-zinc-600 dark:text-zinc-400">{c.text}</p>
                  {c.stack && <p class="mt-2 text-sm text-zinc-500"><b>Stack</b> {c.stack}</p>}
                </div>
              ))}
            </div>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-4">
    <h2 class={h2}>Technical skills</h2>
    <dl class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {Object.entries(cv.skills).map(([group, items]) => (
        <div>
          <dt class="font-semibold">{group}</dt>
          <dd class="mt-2 flex flex-wrap gap-2">
            {items.map((s) => {
              const i = icon(s);
              return (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 px-3 py-1 text-sm">
                  {i && <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill={i.color} fill-rule={i.rule} aria-hidden="true"><path d={i.path} /></svg>}
                  {s}
                </span>
              );
            })}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mt-12 grid gap-8 sm:grid-cols-3">
    <div>
      <h2 class={h2}>Education</h2>
      <p class="mt-3"><b>{cv.education.title}</b> — {cv.education.field}</p>
      <p class="text-sm text-zinc-500">{cv.education.details}</p>
    </div>
    <div>
      <h2 class={h2}>Languages</h2>
      {cv.languages.map((l, i) => <p class={i ? '' : 'mt-3'}><b>{l.name}</b> — {l.level}</p>)}
    </div>
    <div>
      <h2 class={h2}>Interests</h2>
      <p class="mt-3 text-zinc-600 dark:text-zinc-400">{cv.interests.join(' · ')}</p>
    </div>
  </section>
</Base>
