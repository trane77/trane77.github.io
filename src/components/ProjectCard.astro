---
import type { CollectionEntry } from 'astro:content';
import { getRepo } from '../lib/github';

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { title, description, cover, tags, repo } = project.data;
const info = await getRepo(repo);
---
<a href={`/projects/${project.id}/`} class="group block rounded-2xl border border-zinc-200 dark:border-zinc-800 overflow-hidden hover:-translate-y-1 hover:shadow-xl hover:shadow-accent/10 transition">
  {cover
    ? <img src={cover} alt="" class="aspect-video w-full object-cover" transition:name={`cover-${project.id}`} />
    : <div class="aspect-video bg-gradient-to-br from-accent/30 to-fuchsia-500/20" transition:name={`cover-${project.id}`} />}
  <div class="p-5">
    <h3 class="font-semibold group-hover:text-accent transition-colors" transition:name={`title-${project.id}`}>{title}</h3>
    <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{description}</p>
    <div class="mt-3 flex flex-wrap gap-2 text-xs text-zinc-500">
      {info?.language && <span>{info.language}</span>}
      {info && info.stars > 0 && <span>★ {info.stars}</span>}
      {tags.map((t) => <span class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5">{t}</span>)}
    </div>
  </div>
</a>
